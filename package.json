{
  "name": "cinefern",
  "version": "5.0.0",
  "private": true,
  "description": "An open, universal media player built with React Native",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/iteufel/cinefern.git"
  },
  "main": "index.ts",
  "workspaces": [
    "packages/*",
    "apps/tv"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "react-native": "npm:react-native-tvos@0.86.3-0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "tvos": "npm run ios --workspace @cinefern/tv --",
    "tvos:start": "npm run start --workspace @cinefern/tv --",
    "tvos:generate": "npm run native:generate --workspace @cinefern/tv --",
    "build:tvos": "npm run build --workspace @cinefern/tv",
    "tvos:assets": "node scripts/tv-assets.mjs",
    "native:generate": "expo prebuild",
    "build": "expo export --platform web",
    "build:mobile": "expo export --platform ios --platform android --output-dir dist-mobile",
    "desktop": "node scripts/desktop-dev.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "plugin:build": "node scripts/build-provider.mjs",
    "plugin:example": "npm run plugin:build -- providers/example/provider.ts providers/example/manifest.json",
    "format": "prettier --write src packages providers scripts tests apps/desktop apps/tv/*.ts apps/tv/*.json apps/tv/*.cjs App.tsx index.ts *.json *.cjs README.md docs assets/ATTRIBUTION.md .github/workflows"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@cinefern/provider-sdk": "5.0.0",
    "@nyariv/sandboxjs": "^0.9.7",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "dashjs": "^5.0.3",
    "expo": "~57.0.28",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "hls.js": "^1.6.15",
    "lucide-react-native": "^1.57.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@react-native-tvos/config-tv": "0.1.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-property-literals": "^7.29.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
