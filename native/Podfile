source 'https://cdn.cocoapods.org/'
project 'CinefernVLC.xcodeproj'
install! 'cocoapods', :deterministic_uuids => true
use_frameworks!
target 'Cinefern-iOS' do
  platform :ios, '17.0'
  pod 'MobileVLCKit', '3.7.4'
end
target 'Cinefern-tvOS' do
  platform :tvos, '17.0'
  pod 'TVVLCKit', '3.7.4'
end
target 'Cinefern-macOS' do
  platform :osx, '14.0'
  pod 'VLCKit', '3.7.3'
end
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each { |config| config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'; config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.0' if target.platform_name == :osx; config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0' if target.platform_name == :ios; config.build_settings['TVOS_DEPLOYMENT_TARGET'] = '17.0' if target.platform_name == :tvos }
  end
end
