{
  "expo": {
    "name": "Cinefern TV",
    "slug": "cinefern-tv",
    "scheme": "cinefern-tv",
    "version": "5.1.1",
    "orientation": "landscape",
    "icon": "../../assets/icon.png",
    "userInterfaceStyle": "dark",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "io.github.iteufel.cinefern.tv",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Connect to media providers and catalogs on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      "../../plugins/with-apple-scenes.cjs",
      "./with-tv-build.cjs",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "tvosDeploymentTarget": "16.4",
          "appleTVImages": {
            "iconLayers": {
              "front": "../../assets/tv/icon-front-1280x768.png",
              "back": "../../assets/tv/icon-back-1280x768.png"
            },
            "iconSmallLayers": {
              "front": "../../assets/tv/icon-front-400x240.png",
              "back": "../../assets/tv/icon-back-400x240.png"
            },
            "iconSmall2xLayers": {
              "front": "../../assets/tv/icon-front-800x480.png",
              "back": "../../assets/tv/icon-back-800x480.png"
            },
            "topShelf": "../../assets/tv/shelf-1920x720.png",
            "topShelf2x": "../../assets/tv/shelf-3840x1440.png",
            "topShelfWide": "../../assets/tv/shelf-2320x720.png",
            "topShelfWide2x": "../../assets/tv/shelf-4640x1440.png"
          }
        }
      ]
    ]
  }
}
