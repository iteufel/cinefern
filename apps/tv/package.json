{
  "name": "@cinefern/tv",
  "version": "5.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8082",
    "ios": "expo run:ios --port 8082",
    "native:generate": "expo prebuild --platform ios --no-install",
    "build": "expo export --platform ios --output-dir ../../dist-tvos"
  },
  "dependencies": {
    "@cinefern/apple-player": "5.1.0",
    "@cinefern/provider-sdk": "5.1.0",
    "@nyariv/sandboxjs": "^0.9.7",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.28",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "lucide-react-native": "^1.57.0",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-document-picker",
        "expo-sharing",
        "@expo/dom-webview"
      ]
    }
  }
}
